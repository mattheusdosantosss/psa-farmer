# ============================================================
# HUBSPOT
# ============================================================
# Token da Private App do HubSpot
# Onde pegar: HubSpot > Configurações > Integrações > Private Apps
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================================
# PIPELINE: FUNIL DE VENDAS B2B
# ============================================================
# IDs dos estágios usados no dashboard
HUBSPOT_STAGE_NEGOCIO_FECHADO=1076664462
HUBSPOT_STAGE_GANHO_CONTRATO=1076664460
HUBSPOT_STAGE_PERDIDO=1076664461

# ============================================================
# PIPELINE: CS (Tickets)
# ============================================================
# ID da pipeline CS (Configurações > Tickets > Pipelines > CS)
HUBSPOT_PIPELINE_CS=748675953

# Regra de negócio da tramitação (resolvida automaticamente pelo label da etapa
# dentro da pipeline CS). As ENV abaixo são OPCIONAIS — só preencha pra
# sobrescrever a detecção automática. IDs atuais (jun/2026) pra referência:
#   - Demanda / abertos : "Em andamento" (1088360205) + "Iniciar Trâmites" (1088360204)
#   - Concluídos        : "Aprovação Arquivo" (1088361912)  [NÃO é "Concluído"]
#   - Cancelados        : "Cancelado" (1108384635)
# Demanda é SNAPSHOT ao vivo; concluídos/cancelados contam por entrada na etapa
# (hs_v2_date_entered_<stageId>) dentro do período.
# HUBSPOT_PIPELINE_CS_STAGES_ABERTOS=1088360205,1088360204
# HUBSPOT_PIPELINE_CS_STAGE_CONCLUIDO=1088361912
# HUBSPOT_PIPELINE_CS_STAGE_CANCELADO=1108384635

# ============================================================
# ACESSO AO DASHBOARD
# ============================================================
# Chave simples pra proteger a URL do dashboard (qualquer string difícil)
DASHBOARD_ACCESS_KEY=troque-isso-por-uma-chave-secreta
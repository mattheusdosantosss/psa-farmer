# ============================================================
# HUBSPOT
# ============================================================
# Token da Private App do HubSpot
# Onde pegar: HubSpot > Configurações > Integrações > Private Apps
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ============================================================
# PIPELINE: FUNIL DE VENDAS B2B
# ============================================================
# IDs dos estágios usados no dashboard
HUBSPOT_STAGE_NEGOCIO_FECHADO=1076664462
HUBSPOT_STAGE_GANHO_CONTRATO=PREENCHER_DEPOIS
HUBSPOT_STAGE_PERDIDO=1076664461

# ============================================================
# PIPELINE: CS (Tickets)
# ============================================================
# Preencher depois que a permissão da pipeline CS for liberada
HUBSPOT_PIPELINE_CS=PREENCHER_DEPOIS

# ============================================================
# ACESSO AO DASHBOARD
# ============================================================
# Chave simples pra proteger a URL do dashboard (qualquer string difícil)
DASHBOARD_ACCESS_KEY=troque-isso-por-uma-chave-secreta